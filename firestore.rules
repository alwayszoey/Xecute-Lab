rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Master Owner validation with null-safe email check (Strictly cpjustink@gmail.com only)
    function isOwner() {
      return isSignedIn() && 
        request.auth.token.email != null && 
        request.auth.token.email.lower() == 'cpjustink@gmail.com';
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users Collection
    match /users/{userId} {
      // Allow read so users can check username availability and sign in with username/email
      allow read: if true;
      // Users can create their own profile upon signup
      allow create: if isSelf(userId) || isOwner();
      // Users can update their own profile; Owner can update any user (role/balance/status)
      allow update: if isSelf(userId) || isOwner();
      allow delete: if isOwner();
    }

    // Products Collection (Store items)
    match /products/{productId} {
      allow read: if true; // Public catalog viewing
      allow update: if isOwner() || isSignedIn();
      allow create, delete: if isOwner();
    }

    // Categories Collection
    match /categories/{categoryId} {
      allow read: if true; // Public category viewing
      allow create, update, delete: if isOwner();
    }

    // Site Settings (CMS, Marquee Ticker, Store Maintenance Mode)
    match /site_settings/{settingId} {
      allow read: if true; // Public store config
      allow create, update, delete: if isOwner();
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read: if isOwner() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if true;
      allow update, delete: if isOwner();
    }

    // License Keys & Stock Vault
    match /license_keys/{keyId} {
      allow read: if isOwner() || (isSignedIn() && (!resource.data.isUsed || resource.data.usedByEmail == request.auth.token.email));
      allow update: if isOwner() || (isSignedIn() && !resource.data.isUsed && request.resource.data.isUsed == true);
      allow create, delete: if isOwner();
    }

    // Audit Logs (Activity History)
    match /audit_logs/{logId} {
      allow read, write: if isOwner();
    }

    // Tags & Badges Master
    match /tags/{tagId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Script Updates & Patch Notes
    match /script_updates/{updateId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Connection & benchmark test documents
    match /test/{testId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Giveaways Collection
    match /giveaways/{giveawayId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Promo Codes Collection
    match /promo_codes/{codeId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Claims Collection
    match /claims/{claimId} {
      allow read, write: if isSignedIn();
    }

    // Reviews Collection
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isOwner();
    }

    // Support Chats Collection
    match /support_chats/{chatId} {
      allow read, write: if isSignedIn();
    }

    // Mini-games History Collection
    match /minigames_history/{historyId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isOwner();
    }

    // Trash / Bin Collection
    match /trash/{trashId} {
      allow read, write: if isOwner();
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
